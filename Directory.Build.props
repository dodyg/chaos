<Project>

  <!-- Chaos build defaults. See PLAN.md §3: C# 15.0 pinned, deterministic, warnings as errors, locked restores. -->
  <PropertyGroup>
    <LangVersion>15.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <!-- The Windows publish RID is restored up front, so the committed lock files also cover
         `publish -r win-x64` and the release package builds in locked mode (eng/publish-windows.ps1). -->
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <AccelerateBuildsInVisualStudio>true</AccelerateBuildsInVisualStudio>
  </PropertyGroup>

</Project>
