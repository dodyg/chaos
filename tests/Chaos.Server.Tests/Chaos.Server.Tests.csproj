<Project Sdk="Microsoft.NET.Sdk">

  <!-- Server tests against a real PostgreSQL (PLAN2 §8.8): CHAOS_TEST_PG when set, otherwise a
       Testcontainers PostgreSQL in Docker. Neither available is a failure, never a skip. -->
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <RootNamespace>Chaos.Server.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
    <!-- The only projects allowed to use EF Core (Directory.Build.targets, PLAN2 §2.1). -->
    <ChaosAllowEfCore>true</ChaosAllowEfCore>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="TUnit" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
    <PackageReference Include="Testcontainers.PostgreSql" />
    <!-- The fake GitHub API of the infrastructure tests, for the two-account GitHub flows (PLAN3 Q15). -->
    <Compile Include="..\Chaos.Infrastructure.Tests\Testing\FakeGitHub.cs" Link="Testing\FakeGitHub.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Chaos.Server\Chaos.Server.csproj" />
    <!-- The desktop service client is tested against the in-process server (PLAN2 P12 item 6). -->
    <ProjectReference Include="..\..\src\Chaos.Infrastructure\Chaos.Infrastructure.csproj" />
  </ItemGroup>

</Project>
