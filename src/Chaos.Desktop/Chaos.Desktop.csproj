<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Windows host: first supported desktop deliverable (plan §1/§4). NativeAOT off for Phase 1 (plan §3). -->
    <TargetFramework>net11.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <!-- WinExe: a windowed app with no console, so WebView2 child processes have nowhere to print
         their own Chromium shutdown logs (e.g. "Failed to unregister class Chrome_WidgetWin_0"). -->
    <OutputType>WinExe</OutputType>
    <PublishAot>false</PublishAot>
    <IsAotCompatible>false</IsAotCompatible>
    <RootNamespace>Chaos.Desktop</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Icons\chaos.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <!-- Tray icon (PLAN §13); regenerate with eng/make-assets.ps1. -->
    <Content Include="Icons\chaos.ico" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="NeoAstra" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Chaos.Application\Chaos.Application.csproj" />
    <ProjectReference Include="..\Chaos.Desktop.Windows\Chaos.Desktop.Windows.csproj" />
    <ProjectReference Include="..\Chaos.Domain\Chaos.Domain.csproj" />
    <ProjectReference Include="..\Chaos.Infrastructure\Chaos.Infrastructure.csproj" />
  </ItemGroup>

</Project>
